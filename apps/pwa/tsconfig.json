{
  "compilerOptions": {
    "paths": {
      "~/*": ["./*"]
    },
    "strict": true,
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "preserveSymlinks": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noImplicitAny": false,
    "allowImportingTsExtensions": true,
    "target": "es2022",
    "types": ["node", "react", "vite/client"],
    "lib": ["dom", "esnext"]
  },
  "exclude": ["node_modules", ".expo", "**/test", "**/dist", "**/types", "**/__tests__"],
  "typeAcquisition": {
    "enable": true
  }
}
