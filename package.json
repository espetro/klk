{
  "name": "klk",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "bun scripts/dev.ts",
    "dev:turbo": "turbo dev",
    "dev:stop": "bun scripts/dev.ts --stop",
    "dev:status": "bun scripts/dev.ts --status",
    "dev:ios": "bun scripts/dev.ts --ios",
    "dev:android": "bun scripts/dev.ts --android",
    "lint": "oxlint . --config oxlint.config.ts",
    "lint:fix": "oxlint . --config oxlint.config.ts --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo test",
    "validate": "turbo run validate",
    "depcruise": "depcruise apps/*/src packages/*/src --config .dependency-cruiser.mjs",
    "seed": "bun run scripts/seed.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^17.4.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-config-universe": "^0.0.3",
    "tasuku": "2.3.0",
    "turbo": "^2.0.0"
  },
  "packageManager": "bun@1.2.13",
  "patchedDependencies": {
    "@react-native/gradle-plugin@0.85.3": "patches/@react-native%2Fgradle-plugin@0.85.3.patch",
    "expo-crypto@56.0.4": "patches/expo-crypto@56.0.4.patch",
    "expo-modules-core@56.0.12": "patches/expo-modules-core@56.0.12.patch"
  }
}
