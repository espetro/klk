{
  "name": "klk",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint . --config .oxlintrc.json",
    "lint:fix": "oxlint . --config .oxlintrc.json --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo test",
    "validate": "bun run scripts/validate.ts",
    "depcruise": "depcruise apps/*/src packages/*/src --config .dependency-cruiser.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@nanostores/persistent": "^1.0.0",
    "@types/bun": "1.3.14",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^17.4.0",
    "nanostores": "^1.0.0",
    "neverthrow": "^8.2.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-config-universe": "^0.0.3",
    "tasuku": "2.3.0",
    "valibot": "^1.4.0"
  },
  "packageManager": "bun@1.2.13"
}
