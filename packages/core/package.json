{
  "name": "@klk/core",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ports": {
      "types": "./src/ports/index.ts",
      "default": "./src/ports/index.ts"
    },
    "./ports/*": "./src/ports/*.ts",
    "./domain": {
      "types": "./src/domain/index.ts",
      "default": "./src/domain/index.ts"
    },
    "./domain/*": "./src/domain/*.ts"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "valibot": "^1.4.0"
  }
}
