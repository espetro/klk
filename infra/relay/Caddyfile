# Replace relay.yourdomain.com with your actual subdomain
relay.yourdomain.com {
    # Cloudflare Origin Certificate — place cert + key in ./certs/
    tls /certs/origin.pem /certs/origin-key.pem

    reverse_proxy strfry:7777 {
        # Pass real IP through Cloudflare proxy headers
        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
    }
}
